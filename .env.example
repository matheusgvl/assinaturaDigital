# Copie este arquivo para .env e configure o ambiente local.
# Nunca versione o arquivo .env com configurações reais.

# Porta HTTP da API.
# Tipo: inteiro entre 1 e 65535.
# Obrigatoriedade: obrigatória para iniciar a aplicação.
# Formato: número inteiro, por exemplo 3001.
# A aplicação recusa iniciar quando estiver ausente, vazia ou inválida.
PORT=3000
