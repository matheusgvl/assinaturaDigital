# ==================================================
# Assinatura Digital — Backend
# RNF-06 — Configurações de ambiente
# ==================================================

# Copie este arquivo para .env e configure o ambiente local.
# Nunca versione o arquivo .env com configurações reais.

# Porta HTTP da API.
# Tipo: inteiro entre 1 e 65535.
# Obrigatoriedade: obrigatória para iniciar a aplicação.
# Formato: número inteiro, por exemplo 3001.
# A aplicação recusa iniciar quando estiver ausente, vazia ou inválida.
PORT=3000

# URL PostgreSQL obrigatória.
# Não inclua credenciais reais neste arquivo versionado.
DATABASE_URL=

# TLS da conexão PostgreSQL.
# Valores permitidos: true ou false.
# false é adequado somente para PostgreSQL local autorizado.
DATABASE_SSL=false

# Origens HTTP autorizadas, separadas por vírgula.
# Nunca use *; informe somente origens completas http:// ou https://.
CORS_ORIGINS=http://localhost:5173

# WebAuthn. Use o hostname exato do frontend, sem esquema nem porta.
# Liste origens completas do mesmo hostname. HTTP é aceito em localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173

# Chaves RSA em Base64 para assinatura RS256 dos access tokens.
# Gere localmente; nunca versione as chaves privadas.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Chave de 32 bytes em Base64 para cifrar as chaves privadas dos assinantes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca versione o valor real.
PDF_MASTER_KEY_B64=
